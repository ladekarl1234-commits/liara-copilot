{
  "name": "liara-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Grounded AI copilot for Liara — ask, fix, and guide over official Liara docs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-docs": "node scripts/sync-docs.mjs",
    "docs:sync": "node scripts/sync-docs.mjs",
    "build-index": "tsx scripts/build-index.ts",
    "index": "npm run sync-docs && npm run build-index",
    "evaluate": "tsx scripts/evaluate.ts",
    "evaluate:retrieval": "tsx scripts/evaluate.ts --retrieval-only",
    "benchmark:retrieval": "tsx scripts/evaluate.ts --retrieval-only",
    "benchmark:load": "node scripts/benchmark-load.mjs",
    "eval": "tsx scripts/evaluate.ts --retrieval-only"
  },
  "dependencies": {
    "minisearch": "^7.1.0",
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "_overrides_note": "pin patched transitive deps without the Next 16 major bump; sharp is unreachable (no next/image), postcss is build-time only",
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "^0.35.0"
  }
}
