# ─── LLM provider (OpenRouter Free Router by default) ────────────────────────
# Get a key at https://openrouter.ai/keys. Server-side only — never exposed.
OPENROUTER_API_KEY=
# Default model is the OpenRouter Free Router (dynamic; underlying model varies).
# Pin a specific free model here only if evaluation shows it is clearly better.
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Generic OpenAI-compatible provider (overrides OpenRouter if set).
# Use for Liara AI (https://ai.liara.ir/api/v1/<workspace>), OpenAI, Ollama, ...
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL_FAST=            # planning + simple answers (default: openrouter/free)
# AI_MODEL_SMART=           # troubleshooting/low-confidence (default: = fast)
# AI_EMBEDDINGS_MODEL=      # unset = lexical-only retrieval (hybrid off)

# Deterministic mock LLM — for load tests and offline dev. Makes zero external
# calls. NEVER use for LLM-quality evaluation.
# LLM_MOCK=off

# ─── Voice (Soniox Speech-to-Text) ───────────────────────────────────────────
# Get a key at https://console.soniox.com. Server-side only.
SONIOX_API_KEY=
# SONIOX_MODEL=stt-async-v5
# SONIOX_BASE_URL=https://api.soniox.com
# VOICE_MAX_BYTES=8000000

# ─── Behavior / cost ─────────────────────────────────────────────────────────
# VERIFY_CLAIMS=on
# MODEL_TIMEOUT_MS=30000
# MODEL_MAX_RETRIES=2
# COST_INPUT_PER_MTOK=      # USD / 1M input tokens (for estimated_cost metric)
# COST_OUTPUT_PER_MTOK=

# ─── Security ────────────────────────────────────────────────────────────────
# RATE_LIMIT_RPM=20
# TRUST_PROXY=off           # 'on' ONLY behind a trusted LB that sets x-forwarded-for
# MAX_INPUT_CHARS=8000
# MAX_BODY_BYTES=64000

# ─── Diagnostics ─────────────────────────────────────────────────────────────
# DIAG_ENABLED=             # default: on in dev, off in prod. Gates /internal + /api/diag
