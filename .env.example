# ─── LLM provider (OpenRouter) ───────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys. Server-side only — never exposed.
OPENROUTER_API_KEY=
# Pinned by measurement. NOT `openrouter/free`: that alias routes dynamically and
# was measured landing on nvidia/nemotron-3.5-content-safety — a safety
# CLASSIFIER, which answers "Say OK" with "User Safety: safe" — on 2 of 6
# samples. A third sample returned content:null with the whole budget spent on
# reasoning tokens. See specs/phase-iii-vercel.md §2.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Gateway-side fallback chain, tried in order when the primary 429s or 5xxs.
# Free slugs rate-limit without warning, so a single pinned model is a single
# point of failure. Costs no extra round-trip — OpenRouter walks the list.
# AI_MODEL_FALLBACKS=nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-nano-12b-v2-vl:free
# Provider-side reasoning tokens. 'off' is both faster and cheaper for grounded
# RAG: measured 3330ms / 81 output tokens off, vs 7350ms / 311 tokens (329 of
# them reasoning) on, same model and prompt.
# AI_REASONING=off
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── Conversation state (REQUIRED on any multi-instance / serverless target) ──
# HMAC key (>=16 chars) for the signed conversation state the client carries
# back each turn. Without it, state lives only in this process's memory: with N
# instances behind a non-sticky LB, ~(N-1)/N of follow-up turns silently start a
# brand-new conversation. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Generic OpenAI-compatible provider (overrides OpenRouter if set).
# Use for Liara AI (https://ai.liara.ir/api/v1/<workspace>), OpenAI, Ollama, ...
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL_FAST=            # planning + simple answers (default: OPENROUTER_MODEL)
# AI_MODEL_SMART=           # troubleshooting/low-confidence (default: = fast)
# Retrieval mode. DEFAULT is `baai/bge-m3` through the configured provider.
# Measured on the same corpus and eval set, hybrid vs lexical-only:
#   hit@5 0.833 -> 0.896   MRR 0.630 -> 0.748   evidence-recall 0.792 -> 0.896
#   <provider-model-id>       DEFAULT (baai/bge-m3). ~$0.01 per full index build,
#                             ~750ms per query — overlapped with the planner call
#                             so it costs no time-to-first-token.
#   local:                    in-process WASM (multilingual-e5-small), no API key.
#                             NOT deployable serverlessly: 126 MB of function
#                             bundle, and a truncated weights cache aborts the
#                             Node process (exit 127) instead of degrading.
#   (empty)                   force lexical-only: no provider call at query time
# This MUST match the `model` recorded in data/index/vectors.json, or loadIndex()
# refuses to load the vectors rather than silently compare incompatible spaces.
# Re-run `npm run index` after changing it.
# AI_EMBEDDINGS_MODEL=baai/bge-m3

# Deterministic mock LLM — for load tests and offline dev. Makes zero external
# calls. NEVER use for LLM-quality evaluation.
# LLM_MOCK=off

# ─── Voice (Soniox Speech-to-Text) ───────────────────────────────────────────
# Get a key at https://console.soniox.com. Server-side only.
SONIOX_API_KEY=
# SONIOX_MODEL=stt-async-v5
# SONIOX_BASE_URL=https://api.soniox.com
# VOICE_MAX_BYTES=8000000   # 4000000 on Vercel by default: the platform rejects
#                           # bodies over 4.5MB at the edge, so a larger value
#                           # makes the app's own error path unreachable

# ─── Behavior / cost ─────────────────────────────────────────────────────────
# VERIFY_CLAIMS=on
# MODEL_TIMEOUT_MS=15000
# MODEL_MAX_RETRIES=2
# Wall-clock bound on ONE query-side embedding call. The local model is baked
# into the Docker image (TRANSFORMERS_CACHE); if it is ever missing, this stops
# a ~90 MB hub download from hanging the request — retrieval degrades to
# lexical-only for that turn instead. Warm load 766ms, warm embed 5ms.
# EMBED_TIMEOUT_MS=10000
# COST_INPUT_PER_MTOK=      # USD / 1M input tokens (for estimated_cost metric)
# COST_OUTPUT_PER_MTOK=

# ─── Security ────────────────────────────────────────────────────────────────
# RATE_LIMIT_RPM=20
# TRUST_PROXY=off           # 'on' ONLY behind a trusted LB that sets x-forwarded-for.
#                           # Defaults to 'on' automatically when VERCEL is set:
#                           # with it off, clientIp() returns the literal 'direct'
#                           # for every visitor and ALL traffic shares one bucket.
# MAX_INPUT_CHARS=8000
# MAX_BODY_BYTES=64000

# ─── Diagnostics ─────────────────────────────────────────────────────────────
# DIAG_ENABLED=             # default: on in dev, off in prod. Gates /internal + /api/diag
