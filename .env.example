# ---- Model provider (OpenAI-compatible) -------------------------------------
# Works with Liara AI (recommended), OpenRouter, OpenAI, or a local Ollama.
# Liara AI: create a workspace at https://console.liara.ir → AI, then:
#   AI_BASE_URL=https://ai.liara.ir/api/v1/<your-workspace-id>
AI_BASE_URL=
AI_API_KEY=
# Cheap/fast model: planning, verification, simple grounded answers
AI_MODEL_FAST=openai/gpt-4.1-mini
# Stronger model: troubleshooting & multi-step reasoning (omit to reuse FAST)
AI_MODEL_SMART=
# Embeddings model for hybrid (vector) retrieval. Leave empty for the
# lexical-only index — retrieval works without any key.
AI_EMBEDDINGS_MODEL=

# Post-answer claim verification against retrieved evidence (on|off)
VERIFY_CLAIMS=on
MODEL_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=2

# Optional cost accounting (USD per 1M tokens) for the estimated_cost metric
COST_INPUT_PER_MTOK=
COST_OUTPUT_PER_MTOK=

# ---- Security ----------------------------------------------------------------
RATE_LIMIT_RPM=20
MAX_INPUT_CHARS=8000
MAX_BODY_BYTES=64000

# ---- Paths -------------------------------------------------------------------
# Where the official docs repo is cloned by `npm run sync-docs`
DOCS_DIR=data/liara-docs
INDEX_DIR=data/index
RUNTIME_DIR=data/runtime

# Dev diagnostics endpoint /api/diag (defaults: on in dev, off in production)
# DIAG_ENABLED=on
